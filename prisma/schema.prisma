generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  profileId String   @unique
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  matches Match[]
}

model Profile {
  id         String   @id @default(cuid())
  name       String
  age        Int
  photoUrl   String
  bio        String
  city       String
  college    String?
  interests  String
  isDemoUser Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User?

  outgoingSwipes Swipe[] @relation("SwipeActor")
  incomingSwipes Swipe[] @relation("SwipeTarget")

  matches Match[]

  @@index([isDemoUser])
}

model Swipe {
  id        String   @id @default(cuid())
  actorId   String
  targetId  String
  action    String
  createdAt DateTime @default(now())

  actor  Profile @relation("SwipeActor", fields: [actorId], references: [id], onDelete: Cascade)
  target Profile @relation("SwipeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([actorId, targetId])
  @@index([targetId, action])
}

model Match {
  id        String   @id @default(cuid())
  userId    String
  profileId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([userId, profileId])
}
